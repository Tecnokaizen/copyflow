# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only privileged key (never NEXT_PUBLIC_*). Prefer the new Secret API Key.
# Used by Billing webhook, invitations signup, and internal jobs.
# SUPABASE_SECRET_KEY=sb_secret_...
# Temporary legacy fallback (JWT service_role). Prefer SUPABASE_SECRET_KEY above.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Server-only (never NEXT_PUBLIC_*) ---
# Kiosk request signing (required only when a tenant opts into Kiosk).
# Use the same >=32-character value stored in Supabase Vault as
# `kiosk_signing_secret`. Generate independently per environment.
# KIOSK_SIGNING_SECRET=
#
# Vercel Preview only (VERCEL_ENV=preview). Tenant hostnames under this base:
# `{slug}.preview.app.gestcopy.com` → slug. Ignored outside Preview.
# TENANT_PREVIEW_BASE_DOMAIN=preview.app.gestcopy.com
#
# Invitation link origin (optional; defaults to https://app.gestcopy.com)
# Local: APP_BASE_URL=http://localhost:3000
# Production (Vercel): APP_BASE_URL=https://app.gestcopy.com

# Resend (required in Production; domain gestcopy.com must be verified)
# RESEND_API_KEY=
# EMAIL_FROM=Gestcopy <invitaciones@gestcopy.com>

# Local/test ONLY — must NOT exist in Vercel Production:
# EMAIL_TRANSPORT=console   # simulate success without sending
# EMAIL_TRANSPORT=fail      # simulate provider failure

# --- Cloudflare R2 (Files V1 · server-only) ---
# Private shared bucket gestcopy-files. Do NOT set real values in this file.
# Not configured in Vercel yet for F2-A.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=gestcopy-files
# Optional override (defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com):
# R2_ENDPOINT=

# Files V1 HMAC capability (server-only). Same >=32-char value as Vault
# secret name `files_signing_secret`. Never NEXT_PUBLIC_*.
# FILES_SIGNING_SECRET=
#
# Vercel Cron / internal maintenance authentication. Generate >=32 random chars.
# Vercel sends it as Authorization: Bearer <CRON_SECRET> to registered cron routes.
# CRON_SECRET=

# --- Stripe Billing V1 (server-only) ---
# Do NOT set real values in this file. Never use NEXT_PUBLIC_ for these.
# Required only when billing routes/helpers are invoked (Checkout/webhook later).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_MODE=test
# STRIPE_MODE=live
