# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# --- Server-only (never NEXT_PUBLIC_*) ---
# Invitation link origin (optional; defaults to https://app.gestcopy.com)
# Local: APP_BASE_URL=http://localhost:3000
# Production (Vercel): APP_BASE_URL=https://app.gestcopy.com

# Resend (required in Production; domain gestcopy.com must be verified)
# RESEND_API_KEY=
# EMAIL_FROM=Gestcopy <invitaciones@gestcopy.com>

# Local/test ONLY — must NOT exist in Vercel Production:
# EMAIL_TRANSPORT=console   # simulate success without sending
# EMAIL_TRANSPORT=fail      # simulate provider failure
